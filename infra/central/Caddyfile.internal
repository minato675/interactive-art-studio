{
	admin off
	auto_https disable_redirects
	# IP 접속 클라이언트는 SNI를 생략할 수 있다. Docker 내부 IP로 인증서를 찾지 않게 한다.
	default_sni {$CENTRAL_HOST}
	servers {
		protocols h1 h2
	}
}

https://{$CENTRAL_HOST} {
	tls internal
	redir /infra/monitor /infra/monitor/ 308
	handle_path /infra/monitor/* {
		root * /srv/monitor
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "no-referrer"
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		file_server
	}
	handle_path /infra/earth-pc2/* {
		@native_operator path /operator/*
		respond @native_operator 404
		reverse_proxy earth-pc2-queue:8014
	}
	@api path /health /ready /auth/* /api/* /infra/*
	handle @api {
		reverse_proxy central:8000
	}
	handle {
		respond "API endpoint only" 404
	}
}
